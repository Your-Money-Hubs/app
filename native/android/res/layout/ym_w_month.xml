<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ym_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
<TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月累计支出" android:textColor="@color/ym_w_sub" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/w_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RM 1,321" android:textColor="@color/ym_w_text" android:textSize="22sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
<ImageView android:id="@+id/w_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:scaleType="fitCenter" android:src="@drawable/ym_dino_r"/>
<TextView android:id="@+id/w_legend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="━ 本月  ┅ 上月同期 RM 1,560" android:textColor="@color/ym_w_sub" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</FrameLayout>
